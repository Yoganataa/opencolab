{
  "name": "opencolab",
  "displayName": "OpenColab",
  "description": "Manage a persistent Google Colab browser session and Colab-hosted 9Router from OpenChamber.",
  "version": "0.1.0",
  "apiVersion": 1,
  "engines": {
    "openchamber": ">=1.22.0"
  },
  "contributes": {
    "panel": {
      "id": "opencolab",
      "name": "OpenColab",
      "icon": "icon.svg",
      "entry": "panel/index.html",
      "dock": "top",
      "size": 58
    },
    "service": {
      "entry": "service/main.js",
      "runtime": "host",
      "surface": true,
      "permissions": {
        "exec": [
          "google-chrome",
          "chromium",
          "chromium-browser",
          "chrome",
          "msedge",
          "microsoft-edge"
        ]
      }
    }
  }
}
