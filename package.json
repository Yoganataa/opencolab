{
  "name": "opencolab",
  "version": "0.1.5",
  "description": "Open Google Colab automatically inside OpenChamber with a persistent browser session.",
  "private": false,
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.4"
    },
    "contributes": {
      "panel": {
        "id": "open-colab",
        "name": "OpenColab",
        "icon": "icon.svg",
        "entry": "panel/index.html",
        "dock": "top",
        "size": 58
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "surface": true,
        "permissions": {
          "exec": [
            "google-chrome",
            "google-chrome-stable",
            "chromium",
            "chromium-browser",
            "microsoft-edge",
            "microsoft-edge-stable"
          ]
        }
      }
    }
  }
}
